/*
========================================================================================
    Singularity Configuration
========================================================================================
    Singularity-specific settings for the vcf-liftover pipeline
========================================================================================
*/

singularity {
    enabled = true
    autoMounts = true
    cacheDir = "${params.singularity_cache_dir}"
    runOptions = "--bind ${params.scratch_dir} --bind /users"
}

process {
    // Container assignments by label (only containers, no resource requirements)
    // Resource requirements should be set in base config or profile configs
    withLabel: 'crossmap' {
        container = 'docker://mamana/crossmap:latest'
    }

    withLabel: 'vcf_processing' {
        container = 'docker://mamana/vcf-processing:latest'
    }

    withLabel: 'imputation' {
        container = 'docker://mamana/imputation:latest'
    }

    withLabel: 'general' {
        container = 'docker://mamana/vcf-processing:latest'
    }

    withLabel: 'python' {
        container = 'docker://mamana/vcf-processing:latest'
    }

    withLabel: 'samtools' {
        container = 'docker://mamana/vcf-processing:latest'
    }

    withLabel: 'picard' {
        container = 'docker://broadinstitute/gatk:4.5.0.0'
    }

    withLabel: 'latex_report' {
        container = 'docker://texlive/texlive:latest'
    }
}

// Singularity-specific environment variables
env {
    SINGULARITY_CACHEDIR = "${params.singularity_cache_dir}"
    TMPDIR = "${params.scratch_dir}"
}
